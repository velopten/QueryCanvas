# 이 파일을 backend/.env 로 복사한 뒤 값을 채우세요. (.env 는 gitignore 됨)

# ── 필수 ──
ANTHROPIC_API_KEY=sk-ant-...

# ── 선택 ──
# 활성 도메인 팩 — backend/domains/<이름>
#DOMAIN=commerce

# 모델 맵 — 기본값은 config.py 참조
#MODEL_SQL_GEN=claude-sonnet-5
#MODEL_UI_DECISION=claude-sonnet-5
#MODEL_CLASSIFY=claude-haiku-4-5
#MODEL_FIX=claude-haiku-4-5
#MODEL_CURATOR=claude-sonnet-5
#SQL_GEN_EFFORT=high
#AGENTIC_SQL=true

#API_PORT=8008
#LOG_LEVEL=DEBUG
