{"id":"64dcc43f5bb6","title":"김민준의 최근 3개월 주문 내역 보여줘","question":"김민준의 최근 3개월 주문 내역 보여줘","sql":"SELECT o.CUST_ID AS 고객ID, cu.CUST_NAME AS 고객명, o.ORDER_DATE AS 주문일, sc.CD_NAME AS 상태, ch.CD_NAME AS 채널,\n       SUM(i.AMOUNT) AS 주문금액\nFROM TB_ORDER o\nJOIN TB_CUSTOMER cu ON o.CUST_ID = cu.CUST_ID\nJOIN TB_ORDER_ITEM i ON o.ORDER_ID = i.ORDER_ID\nJOIN TB_CODE sc ON sc.GRP_CD = 'ORDER_STATUS' AND sc.CD = o.STATUS\nJOIN TB_CODE ch ON ch.GRP_CD = 'CHANNEL' AND ch.CD = o.CHANNEL\nWHERE o.CUST_ID IN ('C0001','C0002')\n  AND o.ORDER_DATE >= date('now', '-3 months')\nGROUP BY o.ORDER_ID, o.CUST_ID, cu.CUST_NAME, o.ORDER_DATE, sc.CD_NAME, ch.CD_NAME\nORDER BY o.ORDER_DATE DESC\nLIMIT 100","data":[{"고객ID":"C0002","고객명":"김민준","주문일":"2026-08-09","상태":"배송중","채널":"웹","주문금액":220000},{"고객ID":"C0002","고객명":"김민준","주문일":"2026-08-03","상태":"배송중","채널":"앱","주문금액":21500},{"고객ID":"C0001","고객명":"김민준","주문일":"2026-08-03","상태":"배송중","채널":"앱","주문금액":761500},{"고객ID":"C0001","고객명":"김민준","주문일":"2026-07-28","상태":"구매확정","채널":"오프라인","주문금액":77500},{"고객ID":"C0001","고객명":"김민준","주문일":"2026-07-27","상태":"구매확정","채널":"웹","주문금액":163500},{"고객ID":"C0001","고객명":"김민준","주문일":"2026-07-27","상태":"구매확정","채널":"앱","주문금액":285000},{"고객ID":"C0001","고객명":"김민준","주문일":"2026-07-25","상태":"구매확정","채널":"앱","주문금액":43000},{"고객ID":"C0001","고객명":"김민준","주문일":"2026-07-25","상태":"구매확정","채널":"웹","주문금액":350000},{"고객ID":"C0001","고객명":"김민준","주문일":"2026-07-25","상태":"구매확정","채널":"앱","주문금액":61000},{"고객ID":"C0001","고객명":"김민준","주문일":"2026-07-25","상태":"구매확정","채널":"앱","주문금액":69000},{"고객ID":"C0001","고객명":"김민준","주문일":"2026-07-23","상태":"구매확정","채널":"오프라인","주문금액":253000},{"고객ID":"C0001","고객명":"김민준","주문일":"2026-07-21","상태":"구매확정","채널":"오프라인","주문금액":52000},{"고객ID":"C0002","고객명":"김민준","주문일":"2026-07-20","상태":"구매확정","채널":"앱","주문금액":1992000},{"고객ID":"C0001","고객명":"김민준","주문일":"2026-07-17","상태":"구매확정","채널":"웹","주문금액":17500},{"고객ID":"C0002","고객명":"김민준","주문일":"2026-07-14","상태":"구매확정","채널":"앱","주문금액":48500},{"고객ID":"C0002","고객명":"김민준","주문일":"2026-07-06","상태":"구매확정","채널":