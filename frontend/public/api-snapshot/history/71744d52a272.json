{"id":"71744d52a272","title":"뷰티의 카테고리 매출이 요즘 늘고 있는지 월별로 보여줘","question":"뷰티의 카테고리 매출이 요즘 늘고 있는지 월별로 보여줘","sql":"SELECT\n  YM AS 월,\n  CATEGORY_CD AS 카테고리코드,\n  CATEGORY_NAME AS 카테고리,\n  ORDER_CNT AS 주문수,\n  QTY AS 판매수량,\n  SALES_AMT AS 매출액\nFROM (\n  SELECT\n    STRFTIME('%Y-%m', o.ORDER_DATE) AS YM,\n    p.CATEGORY_CD,\n    c.CATEGORY_NAME,\n    COUNT(DISTINCT o.ORDER_ID) AS ORDER_CNT,\n    SUM(i.QTY) AS QTY,\n    SUM(i.AMOUNT) AS SALES_AMT\n  FROM TB_ORDER AS o\n  JOIN TB_ORDER_ITEM AS i\n    ON o.ORDER_ID = i.ORDER_ID\n  JOIN TB_PRODUCT AS p\n    ON i.PROD_ID = p.PROD_ID\n  JOIN TB_CATEGORY AS c\n    ON p.CATEGORY_CD = c.CATEGORY_CD\n  WHERE\n    NOT o.STATUS IN ('04', '05')\n  GROUP BY\n    STRFTIME('%Y-%m', o.ORDER_DATE),\n    p.CATEGORY_CD,\n    c.CATEGORY_NAME\n) AS VV_SALES_MONTHLY\nORDER BY\n  카테고리,\n  월","data":[{"월":"2025-08","카테고리코드":"C06","카테고리":"도서","주문수":273,"판매수량":563,"매출액":11529000},{"월":"2025-09","카테고리코드":"C06","카테고리":"도서","주문수":331,"판매수량":740,"매출액":14944500},{"월":"2025-10","카테고리코드":"C06","카테고리":"도서","주문수":348,"판매수량":743,"매출액":15238000},{"월":"2025-11","카테고리코드":"C06","카테고리":"도서","주문수":370,"판매수량":770,"매출액":15656500},{"월":"2025-12","카테고리코드":"C06","카테고리":"도서","주문수":361,"판매수량":763,"매출액":15885500},{"월":"2026-01","카테고리코드":"C06","카테고리":"도서","주문수":360,"판매수량":779,"매출액":16161000},{"월":"2026-02","카테고리코드":"C06","카테고리":"도서","주문수":333,"판매수량":721,"매출액":14911500},{"월":"2026-03","카테고리코드":"C06","카테고리":"도서","주문수":371,"판매수량":809,"매출액":16673000},{"월":"2026-04","카테고리코드":"C06","카테고리":"도서","주문수":372,"판매수량":799,"매출액":16536000},{"월":"2026-05","카테고리코드":"C06","카테고리":"도서","주문수":356,"판매수량":816,"매출액":16788500},{"월":"2026-06","카테고리코드":"C06","카테고리":"도서","주문수":327,"판매수량":685,"매출액":13992500},{"월":"2026-07","카테고리코드":"C06","카테고리":"도서","주문수":312,"판매수량":657,"매출액":13787000},{"월":"2026-08","카테고리코드":"C06","카테고리":"도서","주문수":67,"판매수량":153,"매출액":3070500},{"월":"2025-08","카테고리코드":"C04","카테고리":"뷰티","주문수":449,"판매수량":974,"매출액":40529500},{"월":"2025-09","카테고리코드":"C04","카테고리":"뷰티","주문수":581,"판매수량":13